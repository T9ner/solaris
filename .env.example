# ==============================================================================
# Forge Autonomous Operations with Solari Infrastructure - Environment Configuration
# ==============================================================================

# --- Solari Infrastructure (Unified API for Browsers, Sandboxes, and Desktops) ---
# Obtain from https://console.getsolari.com
SOLARI_API_KEY=slr_live_your_api_key_here

# --- LLM Providers (At least one required for live LLM reasoning) ---
# 1. Anthropic (Recommended for deep reasoning and code generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 2. OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# 3. OpenRouter / Local endpoints (Ollama, vLLM, Groq)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_BASE_URL=http://localhost:11434/v1

# --- Live Tool Integrations (Optional: Read-only tokens for live production sensing) ---
GITHUB_TOKEN=ghp_your_github_token_here
LINEAR_API_KEY=lin_api_your_linear_key_here
SENTRY_AUTH_TOKEN=sntrys_your_sentry_token_here
STRIPE_API_KEY=sk_live_your_stripe_key_here
